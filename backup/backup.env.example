# Settings for backup/backup.sh. setup.sh copies this to backup/backup.env
# (gitignored) and fills it in. Kept out of local/.env so the container never
# sees where its backups go. AWS keys live in the macOS Keychain, not here.

# AWS region for the backup stack and bucket.
BACKUP_REGION=eu-west-2

# Days to keep a file's previous versions (applied when setup.sh runs).
BACKUP_RETENTION_DAYS=30

# Bucket created by backup-infra.yaml (filled in by setup.sh).
BACKUP_BUCKET=

# Folder to back up (filled in by setup.sh as an absolute path).
LOCAL_DIR=
