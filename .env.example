# Copied to local/.env by claude/scripts/init-local.sh; these become container env vars.
TZ=Europe/London

# Resume the previous conversation when Claude restarts (1/0)
CLAUDE_CONTINUE=1

# Start a fresh conversation once a day at this time (HH:MM, container TZ).
# Waits until the chat has been quiet for 10 minutes. Empty = never.
CLAUDE_DAILY_RESET=04:00

# Space-separated channel plugins to load
CLAUDE_CHANNELS=plugin:whatsapp-channel@whatsapp-claude-plugin

# Automatically accept the development-channels warning on start (1/0)
CLAUDE_AUTO_CONFIRM_CHANNELS=1

# Enable Remote Control so the session can be opened from claude.ai or the Claude app (1/0)
CLAUDE_REMOTE_CONTROL=1

# Optional Remote Control session name
CLAUDE_REMOTE_CONTROL_NAME=WhatsApp

# Google Workspace CLI (gws) login scopes, comma-separated, used by gws-login.sh.
# Examples (prefix each with https://www.googleapis.com/auth/):
#   gmail.readonly                 read mail
#   gmail.readonly,gmail.compose   read mail + drafts (compose also allows sending)
#   gmail.modify                   read, send, label, archive
#   calendar / calendar.readonly   calendar read-write / read-only
#GWS_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Voice notes are transcribed locally with faster-whisper (CPU).
# Model: large-v3-turbo (accurate, ~1x real time), small (about 4x faster), etc.
#WHISPER_MODEL=large-v3-turbo
# Language code such as en; empty = detect it from each note
#WHISPER_LANGUAGE=
# The plugin gives up on a transcription after this many ms (plugin default 180000)
#WHISPER_TIMEOUT_MS=180000
# Or skip local transcription and use a cloud API instead: groq or openai
#TRANSCRIPTION_PROVIDER=
#GROQ_API_KEY=

# Extra arguments appended to the claude command
CLAUDE_EXTRA_ARGS=
