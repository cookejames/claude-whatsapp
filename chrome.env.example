# Copied to local/chrome.env by claude/scripts/init-local.sh; env vars for the
# Chrome container only (kept apart from .env so Chrome never sees its secrets).
TZ=Europe/London

# Give Chrome a macOS user agent matching its own version (1/0). See README.
CHROME_MAC_UA=0

# Extra Chrome command-line flags
CHROME_CLI=

# Optional HTTP basic auth for the web desktop (it's bound to 127.0.0.1 anyway)
CUSTOM_USER=
PASSWORD=
