# Copied to local/camoufox.env by claude/scripts/init-local.sh; env vars for the
# browser container only (kept apart from .env so it never sees those secrets).
TZ=Europe/London

# Fingerprint OS and locale. Used only when local/data/camoufox/browser/fingerprint.json
# is first created; delete that file to generate a new fingerprint.
BROWSER_OS=macos
BROWSER_LOCALE=en-GB

# Let Firefox save and fill site passwords (1/0). Camoufox turns this off by default.
BROWSER_PASSWORD_MANAGER=1

# Page opened when the container starts
BROWSER_START_URL=about:home

# Fixed desktop size. Unset = follow the size of the browser window you view it in.
SELKIES_MANUAL_WIDTH=1920
SELKIES_MANUAL_HEIGHT=1080

# Optional HTTP basic auth for the web desktop (it's bound to 127.0.0.1 anyway)
CUSTOM_USER=
PASSWORD=
